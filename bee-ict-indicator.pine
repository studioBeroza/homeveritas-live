// bee ICT ასისტენტი — „bee-ს მენტორშიპის“ ხერხები ლაივ ჩარტზე
// ეს არის სასწავლო ინსტრუმენტი, არა სავაჭრო სიგნალი. ჯერ დემოზე გამოიყენე.
//@version=5
indicator("bee ICT ასისტენტი", "bee ICT", overlay = true, max_boxes_count = 200, max_lines_count = 200, max_labels_count = 200)

// ───────────── პარამეტრები ─────────────
G1 = "1 · სესიები"
showKZ      = input.bool(true, "ჩემი სესიის ფონი", group = G1)
kzSess      = input.session("0930-1100", "ჩემი სესია (New York დროით)", group = G1)
showAsiaLon = input.bool(true, "Asia / London მაქს-მინ (ლიკვიდობა)", group = G1)

G2 = "2 · FVG"
showFvg = input.bool(true, "FVG ზონები", group = G2)
fvgAtr  = input.float(0.25, "მინ. ზომა (ATR-ის წილი)", minval = 0, step = 0.05, group = G2)
fvgMax  = input.int(20, "მაქს. აქტიური FVG", minval = 1, maxval = 100, group = G2)
showHtf = input.bool(true, "HTF FVG (მაღალი თაიმფრეიმი)", group = G2)
htf     = input.timeframe("60", "HTF FVG თაიმფრეიმი", group = G2)

G3 = "3 · ლიკვიდობა / Displacement / MSS"
swLen    = input.int(5, "Swing-ის სიგანე (სანთელი თითო მხარეს)", minval = 2, maxval = 20, group = G3)
showLiq  = input.bool(true, "Swing H/L ხაზები (BSL / SSL)", group = G3)
liqMax   = input.int(16, "მაქს. ხაზები", minval = 2, maxval = 60, group = G3)
mssWin   = input.int(30, "MSS-ის ფანჯარა sweep-ის შემდეგ (სანთელი)", minval = 3, group = G3)
dispMult = input.float(1.2, "Displacement: ტანი ≥ ATR ×", minval = 0.1, step = 0.1, group = G3)

G4 = "4 · Bias და დონეები"
biasIn = input.string("ავტო", "Bias", options = ["ავტო", "Long", "Short"], group = G4)
biasTf = input.timeframe("240", "ავტო bias-ის თაიმფრეიმი", group = G4)
showLv = input.bool(true, "PDH / PDL / NY შუაღამის Open", group = G4)

G5 = "5 · რისკი"
acct     = input.float(50000, "ანგარიში ($)", minval = 0, group = G5)
riskP    = input.float(0.5, "რისკი ერთ ვაჭრობაზე (%)", minval = 0, step = 0.1, group = G5)
pvSel    = input.string("ავტო", "$ ერთ პოინტზე", options = ["ავტო", "MNQ 2", "NQ 20", "MES 5", "ES 50", "MYM 0.5", "MGC 10"], group = G5)
stopMode = input.string("sweep-ის ექსტრემუმი", "სტოპის ადგილი", options = ["sweep-ის ექსტრემუმი", "ფიქსირებული"], group = G5)
stopFix  = input.float(20, "ფიქსირებული სტოპი (პოინტი)", minval = 0, group = G5)
stopBuf  = input.float(1, "ბუფერი სტოპზე (პოინტი)", minval = 0, group = G5)

G6 = "6 · პანელი და ფერები"
showTbl = input.bool(true, "ჩეკლისტის პანელი", group = G6)
tblPos  = input.string("ზედა მარჯვენა", "პანელის ადგილი", options = ["ზედა მარჯვენა", "ქვედა მარჯვენა", "ზედა მარცხენა", "ქვედა მარცხენა"], group = G6)
cBull   = input.color(#13866f, "Bull ფერი", group = G6)
cBear   = input.color(#cf4b3f, "Bear ფერი", group = G6)
cLiq    = input.color(#8a96a6, "ლიკვიდობის ფერი", group = G6)

NY  = "America/New_York"
atr = ta.atr(14)

// ───────────── სესიები ─────────────
inKZ = not na(time(timeframe.period, kzSess, NY))
bgcolor(showKZ and inKZ ? color.new(cBull, 92) : na, title = "ჩემი სესია")

sessHL(string sess, string name) =>
    bool inS = not na(time(timeframe.period, sess, NY))
    var float h = na
    var float l = na
    var line lh = na
    var line ll = na
    var label bh = na
    var label bl = na
    if inS and not inS[1]
        h := high
        l := low
    else if inS
        h := math.max(h, high)
        l := math.min(l, low)
    if showAsiaLon and not inS and inS[1] and not na(h)
        line.delete(lh)
        line.delete(ll)
        label.delete(bh)
        label.delete(bl)
        lh := line.new(bar_index - 1, h, bar_index, h, color = cLiq, style = line.style_dotted, extend = extend.right)
        ll := line.new(bar_index - 1, l, bar_index, l, color = cLiq, style = line.style_dotted, extend = extend.right)
        bh := label.new(bar_index, h, name + " H", style = label.style_none, textcolor = cLiq, size = size.tiny)
        bl := label.new(bar_index, l, name + " L", style = label.style_none, textcolor = cLiq, size = size.tiny)
    [h, l]

[asiaH, asiaL] = sessHL("2000-2359", "Asia")
[lonH, lonL]   = sessHL("0200-0500", "London")

// ───────────── დღიური დონეები ─────────────
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
tMid   = time(timeframe.period, "0000-0001", NY)
newDay = not na(tMid) and na(tMid[1])
var float midOpen = na
if newDay
    midOpen := open
plot(showLv ? pdh : na, "PDH", color.new(cLiq, 20), 1, plot.style_linebr)
plot(showLv ? pdl : na, "PDL", color.new(cLiq, 20), 1, plot.style_linebr)
plot(showLv ? midOpen : na, "NY შუაღამის Open", color.new(color.orange, 30), 1, plot.style_linebr)

// ───────────── Bias ─────────────
htfTrend() =>
    float ph = ta.pivothigh(high, 3, 3)
    float pl = ta.pivotlow(low, 3, 3)
    var float lastH = na
    var float lastL = na
    var int tr = 0
    if not na(ph)
        lastH := ph
    if not na(pl)
        lastL := pl
    if not na(lastH) and close > lastH
        tr := 1
    if not na(lastL) and close < lastL
        tr := -1
    tr

htfTrendPrev() =>
    int t = htfTrend()
    t[1]

biasAuto = request.security(syminfo.tickerid, biasTf, htfTrendPrev(), lookahead = barmerge.lookahead_on)
bias = biasIn == "Long" ? 1 : biasIn == "Short" ? -1 : nz(biasAuto)

// ───────────── HTF FVG ─────────────
htfF() =>
    float bt = ta.valuewhen(low > high[2], low, 0)
    float bb = ta.valuewhen(low > high[2], high[2], 0)
    float st = ta.valuewhen(high < low[2], low[2], 0)
    float sb = ta.valuewhen(high < low[2], high, 0)
    [bt[1], bb[1], st[1], sb[1]]

[hBt, hBb, hSt, hSb] = request.security(syminfo.tickerid, htf, htfF(), lookahead = barmerge.lookahead_on)
pBt = plot(showHtf ? hBt : na, "HTF bull FVG ზედა", color.new(cBull, 60), 1, plot.style_linebr)
pBb = plot(showHtf ? hBb : na, "HTF bull FVG ქვედა", color.new(cBull, 60), 1, plot.style_linebr)
pSt = plot(showHtf ? hSt : na, "HTF bear FVG ზედა", color.new(cBear, 60), 1, plot.style_linebr)
pSb = plot(showHtf ? hSb : na, "HTF bear FVG ქვედა", color.new(cBear, 60), 1, plot.style_linebr)
fill(pBt, pBb, color.new(cBull, 90), "HTF bull FVG")
fill(pSt, pSb, color.new(cBear, 90), "HTF bear FVG")
inHtfBull = not na(hBt) and low <= hBt and high >= hBb
inHtfBear = not na(hSt) and high >= hSb and low <= hSt

// ───────────── FVG (ჩარტის თაიმფრეიმი) ─────────────
type Gap
    box   bx
    bool  bull
    float top
    float bot
    int   idx

var array<Gap> gaps = array.new<Gap>()
bullF = low > high[2] and (low - high[2]) >= atr * fvgAtr
bearF = high < low[2] and (low[2] - high) >= atr * fvgAtr

if bullF
    box b = showFvg ? box.new(bar_index - 2, low, bar_index, high[2], border_color = color.new(cBull, 60), bgcolor = color.new(cBull, 85)) : na
    array.push(gaps, Gap.new(b, true, low, high[2], bar_index))
if bearF
    box b = showFvg ? box.new(bar_index - 2, low[2], bar_index, high, border_color = color.new(cBear, 60), bgcolor = color.new(cBear, 85)) : na
    array.push(gaps, Gap.new(b, false, low[2], high, bar_index))
while array.size(gaps) > fvgMax
    array.shift(gaps)

var int lastTapBull = na
var int lastTapBear = na
if array.size(gaps) > 0
    for i = array.size(gaps) - 1 to 0
        Gap g = array.get(gaps, i)
        if bar_index > g.idx
            bool tapped = g.bull ? low <= g.top : high >= g.bot
            if tapped
                if g.bull
                    lastTapBull := bar_index
                else
                    lastTapBear := bar_index
                if not na(g.bx)
                    box.set_right(g.bx, bar_index)
                    box.set_bgcolor(g.bx, color.new(g.bull ? cBull : cBear, 94))
                    box.set_border_color(g.bx, color.new(g.bull ? cBull : cBear, 85))
                array.remove(gaps, i)
            else if not na(g.bx)
                box.set_right(g.bx, bar_index)

// ───────────── Displacement ─────────────
dispBull = close > open and (close - open) >= atr * dispMult
dispBear = close < open and (open - close) >= atr * dispMult
var int lastDispBull = na
var int lastDispBear = na
if dispBull
    lastDispBull := bar_index
if dispBear
    lastDispBear := bar_index

// ───────────── ლიკვიდობა და Sweep ─────────────
type Liq
    line  ln
    float p
    bool  hi

var array<Liq> liqs = array.new<Liq>()
ph = ta.pivothigh(high, swLen, swLen)
pl = ta.pivotlow(low, swLen, swLen)
var float lastPH = na
var float lastPL = na
if not na(ph)
    lastPH := ph
    line ln = showLiq ? line.new(bar_index - swLen, ph, bar_index, ph, color = color.new(cLiq, 25), style = line.style_dashed) : na
    array.push(liqs, Liq.new(ln, ph, true))
if not na(pl)
    lastPL := pl
    line ln = showLiq ? line.new(bar_index - swLen, pl, bar_index, pl, color = color.new(cLiq, 25), style = line.style_dashed) : na
    array.push(liqs, Liq.new(ln, pl, false))
while array.size(liqs) > liqMax
    Liq old = array.shift(liqs)
    line.delete(old.ln)

var int   sslSweep = na
var int   bslSweep = na
var float setupLow  = na
var float setupHigh = na
bool sweptSSL = false
bool sweptBSL = false
if array.size(liqs) > 0
    for i = array.size(liqs) - 1 to 0
        Liq q = array.get(liqs, i)
        bool taken = q.hi ? high > q.p : low < q.p
        if taken
            if q.hi and close < q.p
                sweptBSL := true
            if not q.hi and close > q.p
                sweptSSL := true
            if not na(q.ln)
                line.set_x2(q.ln, bar_index)
                line.set_style(q.ln, line.style_dotted)
                line.set_color(q.ln, color.new(cLiq, 70))
            array.remove(liqs, i)
        else if not na(q.ln)
            line.set_x2(q.ln, bar_index)

if sweptSSL
    sslSweep := bar_index
    setupLow := low
    label.new(bar_index, low, "SSL sweep", style = label.style_label_up, color = color.new(cBull, 75), textcolor = color.white, size = size.tiny)
if sweptBSL
    bslSweep := bar_index
    setupHigh := high
    label.new(bar_index, high, "BSL sweep", style = label.style_label_down, color = color.new(cBear, 75), textcolor = color.white, size = size.tiny)
if not na(sslSweep) and bar_index - sslSweep <= mssWin
    setupLow := math.min(setupLow, low)
if not na(bslSweep) and bar_index - bslSweep <= mssWin
    setupHigh := math.max(setupHigh, high)

// ───────────── MSS ─────────────
var int bullMss = na
var int bearMss = na
var int bullMssFor = na
var int bearMssFor = na
xUp = ta.crossover(close, lastPH)
xDn = ta.crossunder(close, lastPL)
bullMssNow = not na(sslSweep) and bar_index - sslSweep <= mssWin and not na(lastPH) and xUp and nz(bullMssFor, -1) != sslSweep
bearMssNow = not na(bslSweep) and bar_index - bslSweep <= mssWin and not na(lastPL) and xDn and nz(bearMssFor, -1) != bslSweep
if bullMssNow
    bullMss := bar_index
    bullMssFor := sslSweep
    line.new(sslSweep, lastPH, bar_index, lastPH, color = cBull, width = 2)
    label.new(bar_index, lastPH, "MSS ▲", style = label.style_label_lower_left, color = color.new(cBull, 20), textcolor = color.white, size = size.small)
if bearMssNow
    bearMss := bar_index
    bearMssFor := bslSweep
    line.new(bslSweep, lastPL, bar_index, lastPL, color = cBear, width = 2)
    label.new(bar_index, lastPL, "MSS ▼", style = label.style_label_upper_left, color = color.new(cBear, 20), textcolor = color.white, size = size.small)

// ───────────── ჩეკლისტი ─────────────
d = bias
sweepOk = d == 1 ? (not na(sslSweep) and bar_index - sslSweep <= mssWin) : d == -1 ? (not na(bslSweep) and bar_index - bslSweep <= mssWin) : false
dispOk  = d == 1 ? (sweepOk and nz(lastDispBull, -1) >= sslSweep) : d == -1 ? (sweepOk and nz(lastDispBear, -1) >= bslSweep) : false
mssOk   = d == 1 ? (sweepOk and nz(bullMss, -1) >= sslSweep) : d == -1 ? (sweepOk and nz(bearMss, -1) >= bslSweep) : false
tapOk   = d == 1 ? (mssOk and nz(lastTapBull, -1) > bullMss) : d == -1 ? (mssOk and nz(lastTapBear, -1) > bearMss) : false
htfOk   = d == 1 ? inHtfBull : d == -1 ? inHtfBear : false
ready   = d != 0 and inKZ and sweepOk and dispOk and mssOk and tapOk

var int lastSignal = na
newSignal = ready and not ready[1]
if newSignal
    lastSignal := bar_index
    label.new(bar_index, d == 1 ? low : high, d == 1 ? "A+ LONG\nჩეკლისტი ✓" : "A+ SHORT\nჩეკლისტი ✓", style = d == 1 ? label.style_label_up : label.style_label_down, color = d == 1 ? cBull : cBear, textcolor = color.white, size = size.normal)

// ───────────── რისკი ─────────────
pv = pvSel == "ავტო" ? syminfo.pointvalue : str.tonumber(array.get(str.split(pvSel, " "), 1))
autoStop = d == 1 ? close - setupLow + stopBuf : d == -1 ? setupHigh - close + stopBuf : na
stopPts = stopMode == "ფიქსირებული" or na(autoStop) or autoStop <= 0 ? stopFix : autoStop
budget  = acct * riskP / 100
qty     = stopPts > 0 and pv > 0 ? math.floor(budget / (stopPts * pv)) : 0
riskUsd = qty * stopPts * pv

// სამიზნე: უახლოესი საპირისპირო ლიკვიდობა
float tgt = na
if array.size(liqs) > 0
    for i = 0 to array.size(liqs) - 1
        Liq q = array.get(liqs, i)
        if d == 1 and q.hi and q.p > close
            tgt := na(tgt) ? q.p : math.min(tgt, q.p)
        if d == -1 and not q.hi and q.p < close
            tgt := na(tgt) ? q.p : math.max(tgt, q.p)
rr = not na(tgt) and stopPts > 0 ? math.abs(tgt - close) / stopPts : na

// ───────────── პანელი ─────────────
pos = tblPos == "ზედა მარჯვენა" ? position.top_right : tblPos == "ქვედა მარჯვენა" ? position.bottom_right : tblPos == "ზედა მარცხენა" ? position.top_left : position.bottom_left
var table t = table.new(pos, 2, 13, bgcolor = color.new(#18202a, 8), border_color = color.new(#2a3542, 0), border_width = 1)

row(int r, string k, bool ok, string extra) =>
    table.cell(t, 0, r, k, text_color = color.new(#e6ebf1, 0), text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, (ok ? "✓ " : "✕ ") + extra, text_color = ok ? cBull : color.new(#93a1b2, 0), text_size = size.small, text_halign = text.align_left)

if showTbl and barstate.islast
    string biasTxt = d == 1 ? "▲ LONG" : d == -1 ? "▼ SHORT" : "— გაურკვეველი"
    table.cell(t, 0, 0, "bee ICT", text_color = color.new(#e8a23b, 0), text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 0, "Bias: " + biasTxt + (biasIn == "ავტო" ? " (" + biasTf + ")" : ""), text_color = d == 1 ? cBull : d == -1 ? cBear : color.gray, text_size = size.small, text_halign = text.align_left)
    row(1, "1. ჩემი სესია", inKZ, inKZ ? "ახლაა" : "არა, დაელოდე")
    row(2, "2. Sweep", sweepOk, d == 1 ? "SSL აიღო" : d == -1 ? "BSL აიღო" : "")
    row(3, "3. Displacement", dispOk, "ძლიერი სანთელი")
    row(4, "4. MSS", mssOk, "სტრუქტურა გატყდა")
    row(5, "5. FVG-ში დაბრუნება", tapOk, "შესვლის ზონა")
    row(6, "HTF FVG (" + htf + ")", htfOk, "დამატებითი")
    table.cell(t, 0, 7, "შედეგი", text_color = color.new(#e6ebf1, 0), text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 7, ready ? "✓ სეტაპი სრულია" : "⏳ დაელოდე", text_color = color.white, bgcolor = ready ? cBull : color.new(#5d6b7c, 0), text_size = size.small, text_halign = text.align_left)
    table.cell(t, 0, 8, "სტოპი", text_color = color.new(#e6ebf1, 0), text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 8, str.tostring(stopPts, "#.##") + " პოინტი", text_color = color.new(#e6ebf1, 0), text_size = size.small, text_halign = text.align_left)
    table.cell(t, 0, 9, "კონტრაქტები", text_color = color.new(#e6ebf1, 0), text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 9, str.tostring(qty) + (qty == 0 ? "  (სტოპი დიდია)" : ""), text_color = qty == 0 ? cBear : color.new(#e8a23b, 0), text_size = size.small, text_halign = text.align_left)
    table.cell(t, 0, 10, "რისკი", text_color = color.new(#e6ebf1, 0), text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 10, "$" + str.tostring(riskUsd, "#,###") + " / ლიმიტი $" + str.tostring(budget, "#,###") + (riskP > 1 ? "  ⚠ >1%" : ""), text_color = riskP > 1 ? cBear : color.new(#e6ebf1, 0), text_size = size.small, text_halign = text.align_left)
    table.cell(t, 0, 11, "სამიზნე (ლიკვ.)", text_color = color.new(#e6ebf1, 0), text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 11, na(tgt) ? "—" : str.tostring(tgt, format.mintick) + "  R:R 1:" + str.tostring(rr, "#.#") + (rr < 2 ? " ⚠" : ""), text_color = not na(rr) and rr >= 2 ? cBull : color.new(#e6ebf1, 0), text_size = size.small, text_halign = text.align_left)
    table.cell(t, 0, 12, "შეხსენება", text_color = color.new(#93a1b2, 0), text_size = size.tiny, text_halign = text.align_left)
    table.cell(t, 1, 12, "ნიუსი შეამოწმე · revenge trade არა · ჟურნალი", text_color = color.new(#93a1b2, 0), text_size = size.tiny, text_halign = text.align_left)

// ───────────── Alerts ─────────────
alertcondition(newSignal and d == 1, "A+ LONG სეტაპი", "bee ICT: Long ჩეკლისტი სრულია ({{ticker}})")
alertcondition(newSignal and d == -1, "A+ SHORT სეტაპი", "bee ICT: Short ჩეკლისტი სრულია ({{ticker}})")
alertcondition(sweptSSL, "SSL sweep", "bee ICT: sell-side ლიკვიდობა აიღო ({{ticker}})")
alertcondition(sweptBSL, "BSL sweep", "bee ICT: buy-side ლიკვიდობა აიღო ({{ticker}})")
alertcondition(bullMssNow or bearMssNow, "MSS", "bee ICT: Market Structure Shift ({{ticker}})")
alertcondition(inKZ and not inKZ[1], "სესია დაიწყო", "bee ICT: შენი სესია დაიწყო")
